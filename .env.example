# Public origin used in canonical and social metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only integrations (never prefix these with NEXT_PUBLIC_)
DATABASE_URL=
# JSON protegido com uma ou mais contas: [{"email":"...","password":"..."}]
ADMIN_ACCOUNTS=
# Compatibilidade com instalações que usam apenas uma conta
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CAKTO_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Future fulfillment integrations
SUPPLIER_PROVIDER=manual
AUTO_FULFILLMENT_ENABLED=false
ORGANIC_AUTOMATION_MODE=MANUAL
